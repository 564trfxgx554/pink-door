# 复制为 .env 后按需修改；不创建 .env 也能用默认值启动。
# Java 调用 Python 的内部令牌，必须与 netbar-backend 的 AI_INTERNAL_TOKEN 一致。
AI_INTERNAL_TOKEN=change-me

# mock | openai | anthropic
AI_PROVIDER=mock
# anthropic 默认用 claude-opus-4-8；
# openai 兼容接口请改成 deepseek-chat / qwen-plus 等。
AI_MODEL=claude-opus-4-8
AI_API_KEY=
# OpenAI 兼容接口的地址，例如 https://api.deepseek.com/v1
AI_BASE_URL=
AI_MAX_TOKENS=800
